{
  "name": "kib-yt-flush",
  "version": "1.1.0",
  "description": "Chrome extension (Manifest V3) for local YouTube watch progress resume.",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=11.5.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && rimraf dist && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kibmuikia/kib-yt-flush"
  },
  "keywords": [
    "chrome-extension",
    "vite",
    "javascript",
    "entertainment",
    "youtube",
    "streaming"
  ]
}
